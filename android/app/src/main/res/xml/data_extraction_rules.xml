<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="**/firebase-*.xml" />
        <exclude domain="sharedpref" path="**/com.google.android.gms.*.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="**/firebase-*.xml" />
        <exclude domain="sharedpref" path="**/com.google.android.gms.*.xml" />
    </device-transfer>
</data-extraction-rules>
