<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow local networking for development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    
    <!-- API endpoints with strict HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.coincap.io</domain>
        <domain includeSubdomains="true">api.coingecko.com</domain>
        <domain includeSubdomains="true">api.exchangerate-api.com</domain>
        <domain includeSubdomains="true">api.revenuecat.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">firebaseinstallations.googleapis.com</domain>
        <domain includeSubdomains="true">fcm.googleapis.com</domain>
    </domain-config>
    
    <!-- CDN endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">assets.coingecko.com</domain>
        <domain includeSubdomains="true">currencycryptofiat.netlify.app</domain>
    </domain-config>
</network-security-config>
