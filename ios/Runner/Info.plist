<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ========================================== -->
	<!-- BUNDLE IDENTITY                            -->
	<!-- ========================================== -->

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<!-- Declared localizations — tells App Store this app is relevant in
	     these language/region markets. Improves ASO discoverability even
	     when no .lproj bundles exist (the app stays English-only at runtime).
	     iOS falls back to CFBundleDevelopmentRegion for any unsupported locale. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>de</string>
		<string>pt</string>
		<string>it</string>
		<string>nl</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ar</string>
		<string>hi</string>
		<string>ru</string>
		<string>tr</string>
		<string>pl</string>
		<string>sv</string>
		<string>da</string>
		<string>fi</string>
		<string>nb</string>
		<string>th</string>
		<string>vi</string>
		<string>id</string>
		<string>ms</string>
	</array>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>

	<!-- Version — driven by pubspec.yaml via Flutter build system -->
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ========================================== -->
	<!-- APP NAME & DISCOVERABILITY                 -->
	<!-- ========================================== -->

	<!-- Internal bundle name — must match original to avoid validation errors -->
	<key>CFBundleName</key>
	<string>cryptocurrencyconverter</string>

	<!-- Home screen display name (30 chars max for App Store) -->
	<key>CFBundleDisplayName</key>
	<string>Currency Ex</string>

	<!-- Siri &amp; VoiceOver spoken name — natural language pronunciation -->
	<key>CFBundleSpokenName</key>
	<string>Currency Ex</string>

	<!-- Spotlight on-device indexing (kMDItemKeywords).
	     Indexed by iOS/macOS Spotlight so the app surfaces when users
	     type any of these terms in Spotlight Search on their device.
	     Does NOT affect App Store search rank — use App Store Connect
	     Keywords field for that. Keep ~20 high-signal, non-duplicated terms. -->
	<key>kMDItemKeywords</key>
	<array>
		<string>currency converter</string>
		<string>crypto converter</string>
		<string>bitcoin price</string>
		<string>ethereum price</string>
		<string>exchange rate</string>
		<string>money converter</string>
		<string>forex</string>
		<string>cryptocurrency</string>
		<string>portfolio tracker</string>
		<string>USD EUR GBP</string>
		<string>fiat currency</string>
		<string>real-time rates</string>
		<string>crypto calculator</string>
		<string>BTC ETH SOL</string>
		<string>travel money</string>
		<string>finance app</string>
		<string>coin tracker</string>
		<string>currency calculator</string>
		<string>crypto portfolio</string>
		<string>live exchange rates</string>
	</array>

	<!-- ========================================== -->
	<!-- APP STORE & SYSTEM METADATA                -->
	<!-- ========================================== -->

	<!-- App category — must match Finance selection in App Store Connect -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>

	<!-- Requires iOS (not macOS Catalyst only) -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Encryption export compliance — no exempt encryption used -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ========================================== -->
	<!-- NETWORK SECURITY                           -->
	<!-- ========================================== -->

	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Block all plain HTTP; HTTPS only -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ========================================== -->
	<!-- PRIVACY & TRACKING                         -->
	<!-- ========================================== -->

	<!-- ATT prompt string — required for App Tracking Transparency framework -->
	<key>NSUserTrackingUsageDescription</key>
	<string>We use this to measure advertising effectiveness and improve your experience with personalized content.</string>

	<!-- ========================================== -->
	<!-- SKADNETWORK — AD ATTRIBUTION               -->
	<!-- ========================================== -->

	<key>SKAdNetworkItems</key>
	<array>
		<!-- Google Ads — required for external Google Ads campaign attribution -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<!-- ========================================== -->
	<!-- UI CONFIGURATION                           -->
	<!-- ========================================== -->

	<!-- Supported orientations — iPhone -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Supported orientations — iPad -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Launch screen storyboard (Flutter standard) -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Main storyboard (Flutter standard) -->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Scene manifest (Flutter standard — single-window, no multi-scene) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- Status bar — Flutter controls appearance via SystemChrome -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- ProMotion 120Hz support on iPhone 13 Pro+ -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Pointer / trackpad / keyboard input on iPad -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

</dict>
</plist>
